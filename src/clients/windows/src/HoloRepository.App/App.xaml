<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="HoloRepository.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="HoloAccentBrush" Color="#0E7C86" />
                            <SolidColorBrush x:Key="HoloSuccessBrush" Color="#107C10" />
                            <SolidColorBrush x:Key="HoloWarningBrush" Color="#9D5D00" />
                            <SolidColorBrush x:Key="HoloTileBrush" Color="#1E2A36" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="HoloAccentBrush" Color="#4FD1D9" />
                            <SolidColorBrush x:Key="HoloSuccessBrush" Color="#6CCB5F" />
                            <SolidColorBrush x:Key="HoloWarningBrush" Color="#FCE100" />
                            <SolidColorBrush x:Key="HoloTileBrush" Color="#16202B" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
