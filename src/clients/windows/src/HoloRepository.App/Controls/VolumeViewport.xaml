<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HoloRepository.App.Controls.VolumeViewport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="Black">
        <Grid x:Name="Surface"
              Background="Black"
              SizeChanged="Surface_SizeChanged"
              PointerPressed="Surface_PointerPressed"
              PointerMoved="Surface_PointerMoved"
              PointerReleased="Surface_PointerReleased"
              PointerCaptureLost="Surface_PointerCaptureLost"
              PointerWheelChanged="Surface_PointerWheelChanged"
              DoubleTapped="Surface_DoubleTapped">
            <Image x:Name="RenderImage" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Canvas x:Name="Overlay" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>

        <!-- GPU 3D view (NiiVue in WebView2); shown instead of the CPU render when chosen. -->
        <WebView2 x:Name="NiiVueWeb" Visibility="Collapsed" DefaultBackgroundColor="#FF040A19" />
        <StackPanel x:Name="NiiVueStatus" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed" IsHitTestVisible="False">
            <ProgressRing IsActive="True" Width="18" Height="18" Foreground="White" />
            <TextBlock x:Name="NiiVueStatusText" Text="Preparing 3D view…" Foreground="#DDFFFFFF" VerticalAlignment="Center" />
        </StackPanel>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="4" Background="#99000000" IsHitTestVisible="False">
            <TextBlock x:Name="TitleText" Text="3D" Foreground="#4FD1D9" FontWeight="SemiBold" FontSize="12" />
        </Border>
        <Button x:Name="FullScreenButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="7"
                Background="#99000000" BorderThickness="0" Click="FullScreen_Click"
                AutomationProperties.Name="Full screen" ToolTipService.ToolTip="Full screen">
            <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="14" Foreground="White" />
        </Button>
        <Border x:Name="InfoBadge" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,3" CornerRadius="4" Background="#99000000" IsHitTestVisible="False">
            <TextBlock x:Name="InfoText" Foreground="#DDFFFFFF" FontSize="11" FontFamily="Consolas" />
        </Border>
        <TextBlock x:Name="EmptyText" Text="Drag to rotate · wheel to zoom" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
</UserControl>
