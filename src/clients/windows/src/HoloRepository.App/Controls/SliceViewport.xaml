<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="HoloRepository.App.Controls.SliceViewport"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="Black">
        <Grid x:Name="Surface"
              Background="Black"
              SizeChanged="Surface_SizeChanged"
              PointerPressed="Surface_PointerPressed"
              PointerMoved="Surface_PointerMoved"
              PointerReleased="Surface_PointerReleased"
              PointerCaptureLost="Surface_PointerCaptureLost"
              PointerWheelChanged="Surface_PointerWheelChanged">
            <Image x:Name="SliceImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Canvas x:Name="Overlay" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
        </Grid>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="4" Background="#99000000" IsHitTestVisible="False">
            <TextBlock x:Name="TitleText" Foreground="#4FD1D9" FontWeight="SemiBold" FontSize="12" />
        </Border>
        <Button x:Name="FullScreenButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="7"
                Background="#99000000" BorderThickness="0" Click="FullScreen_Click"
                AutomationProperties.Name="Full screen" ToolTipService.ToolTip="Full screen">
            <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="14" Foreground="White" />
        </Button>
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,3" CornerRadius="4" Background="#99000000" IsHitTestVisible="False">
            <TextBlock x:Name="InfoText" Foreground="#DDFFFFFF" FontSize="11" FontFamily="Consolas" />
        </Border>
        <Border x:Name="CursorBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="8,3" CornerRadius="4" Background="#99000000" IsHitTestVisible="False">
            <TextBlock x:Name="CursorText" Foreground="#DDFFFFFF" FontSize="11" FontFamily="Consolas" />
        </Border>
        <TextBlock x:Name="EmptyText" Text="No scan open" Foreground="#88FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
</UserControl>
