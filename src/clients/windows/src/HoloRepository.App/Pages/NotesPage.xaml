<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HoloRepository.App.Pages.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:notes="using:HoloRepository.Core.Notes"
    NavigationCacheMode="Required">

    <Grid Padding="28,20,28,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Clinical notes" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="EngineText" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Dual-tier notes from the consultation: a coded MDT note and a plain-language patient summary." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="GenerateButton" Style="{StaticResource AccentButtonStyle}" Click="Generate_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Generate" />
                    </StackPanel>
                </Button>
                <Button x:Name="CopyButton" Click="Copy_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Copy" />
                        <TextBlock Text="Copy" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Click="Export_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Save" />
                        <TextBlock Text="Export Markdown…" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="Status" Grid.Row="1" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="UseSampleButton" Content="Use sample consultation" Click="UseSample_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="MDT clinical note" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="for clinicians · draft for review" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="16" Padding="0,0,12,0">
                            <TextBlock x:Name="MdtText" IsTextSelectionEnabled="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                       Text="Generate notes to see the structured MDT summary here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel x:Name="CodesPanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="SNOMED CT grounding" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ItemsControl x:Name="ConceptList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="notes:SnomedConcept">
                                            <Grid ColumnSpacing="10" Padding="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <HyperlinkButton Content="{x:Bind ConceptId}" NavigateUri="{x:Bind BrowserUrl}" Padding="0" FontFamily="Consolas" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind PreferredTerm}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Category}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="NICE guidance to cross-check" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,10,0,0" />
                                <ItemsControl x:Name="GuidelineList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="notes:GuidelineReference">
                                            <StackPanel Padding="0,3">
                                                <HyperlinkButton NavigateUri="{x:Bind Url}" Padding="0">
                                                    <TextBlock>
                                                        <Run Text="{x:Bind Code}" FontWeight="SemiBold" />
                                                        <Run Text=" · " />
                                                        <Run Text="{x:Bind Title}" />
                                                    </TextBlock>
                                                </HyperlinkButton>
                                                <TextBlock Text="{x:Bind Rationale}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Text="Codes are suggestions from a limited offline list. Check them in the NHS SNOMED CT browser before use." />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Patient summary" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Plain English · target reading age 9" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Border x:Name="ReadingBadge" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="12" Padding="10,4" Visibility="Collapsed">
                            <TextBlock x:Name="ReadingBadgeText" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="PatientText" TextWrapping="Wrap" FontSize="18" LineHeight="28" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="A short, friendly explanation for the patient will appear here." />
                    <TextBlock x:Name="ReadabilityDetail" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Language" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox SelectedIndex="0" IsEnabled="False" MinWidth="160" ToolTipService.ToolTip="Translations are planned (FR-14)">
                            <x:String>English (UK)</x:String>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
