<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HoloRepository.App.Pages.StudiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:daemon="using:HoloRepository.Core.Daemon"
    xmlns:local="using:HoloRepository.App.Pages"
    xmlns:imaging="using:HoloRepository.Core.Imaging"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="SeriesChoiceTemplate" x:DataType="imaging:DicomSeriesSummary">
            <StackPanel Padding="0,6" Opacity="{x:Bind local:StudiesPage.OpacityFor(IsSupported)}">
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,20,28,20" RowSpacing="16" AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Studies" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Open a patient's DICOM scan (a folder, files or a .zip), or drag it here. Scans are processed on this computer."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="LoadSampleButton" Style="{StaticResource AccentButtonStyle}" Click="LoadSample_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="Open sample chest CT" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenFolderButton" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="OpenLocal" />
                        <TextBlock Text="Open scan folder…" />
                    </StackPanel>
                </Button>
                <Button x:Name="OpenFilesButton" Click="OpenFiles_Click" ToolTipService.ToolTip="DICOM files (.dcm) or a .zip archive">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock Text="Open DICOM files…" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Click="Export_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="SaveLocal" />
                        <TextBlock Text="Export selected as DICOM…" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ProgressBar x:Name="Progress" Visibility="Collapsed" Maximum="1" />
            <InfoBar x:Name="Status" IsOpen="False" IsClosable="True" />
        </StackPanel>

        <Grid x:Name="ContentGrid" Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DaemonColumn" Width="360" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="8">
                <Grid>
                    <ListView x:Name="SeriesList" SelectionMode="Single" SelectionChanged="SeriesList_SelectionChanged"
                              IsItemClickEnabled="False" DoubleTapped="SeriesList_DoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="daemon:SeriesInfo">
                                <Grid Padding="8,12" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource HoloTileBrush}">
                                        <TextBlock Text="{x:Bind Metadata.Modality}" Foreground="{ThemeResource HoloAccentBrush}" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Metadata.SeriesDescription}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind Metadata.PatientDisplayName}" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind Metadata.PatientId}" />
                                            <Run Text=" · " />
                                            <Run Text="{x:Bind Metadata.StudyDescription}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                            <Run Text="{x:Bind Depth}" />
                                            <Run Text=" images · " />
                                            <Run Text="{x:Bind Metadata.Source}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="380">
                        <FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No scans open" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Open a folder, DICOM files or a .zip of a patient's scan, or drag them onto this page. You can also try the built-in sample chest CT (not a real patient)." />
                    </StackPanel>
                    <Button x:Name="OpenViewerButton" Content="Open in viewer" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" IsEnabled="False" Click="OpenViewer_Click" />
                </Grid>
            </Border>

            <Border x:Name="DaemonCard" Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock Text="Compute daemon" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid ColumnSpacing="8" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Mode" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ModeText" Grid.Column="1" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Endpoint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="EndpointText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="Privacy" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="PrivacyText" Grid.Row="2" Grid.Column="1" Foreground="{ThemeResource HoloSuccessBrush}" TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock Text="Acceleration backends" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,0" />
                    <ItemsControl x:Name="BackendList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="daemon:BackendCapability">
                                <StackPanel Margin="0,0,0,10" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="{x:Bind local:StudiesPage.GlyphFor(Detected)}" FontSize="14"
                                                  Foreground="{ThemeResource HoloAccentBrush}" />
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="· active" Visibility="{x:Bind Active}" Foreground="{ThemeResource HoloSuccessBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="This prototype renders with the CPU reference path. CUDA, Intel ARC (OpenVINO/oneAPI) and RTX Spark (ARM) paths plug in behind the same daemon interface." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
