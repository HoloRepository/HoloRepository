<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HoloRepository.App.Pages.ConsultationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:markup="using:HoloRepository.Core.Markup"
    xmlns:notes="using:HoloRepository.Core.Notes"
    xmlns:local="using:HoloRepository.App.Pages"
    NavigationCacheMode="Required">

    <Grid Padding="28,20,28,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="MDT consultation" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Video conferencing, synchronised viewports and shared markup, with consultation capture for note generation."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: conference + sync -->
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SessionBox" Header="Consultation ID" />
                        <TextBox x:Name="NameBox" Grid.Column="1" Header="Your name" />
                        <Button x:Name="JoinButton" Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}" Click="Join_Click" MinWidth="150">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon x:Name="JoinIcon" Symbol="Video" />
                                <TextBlock x:Name="JoinText" Text="Start consultation" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Conference" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Border Background="{ThemeResource HoloTileBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="Webex SDK integration point · simulated" FontSize="11" Foreground="{ThemeResource HoloAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="CallStatus" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Not connected" />
                        </StackPanel>

                        <GridView x:Name="ParticipantGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="markup:Participant">
                                    <Grid Width="180" Height="118" CornerRadius="8" Background="{ThemeResource HoloTileBrush}">
                                        <PersonPicture Initials="{x:Bind Initials}" Width="56" Height="56" VerticalAlignment="Center" Margin="0,0,0,18" />
                                        <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,8">
                                            <TextBlock Text="{x:Bind DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Role}" Foreground="#AAFFFFFF" FontSize="11" />
                                        </StackPanel>
                                        <FontIcon Glyph="{x:Bind local:ConsultationPage.MicGlyph(MicOn)}" FontSize="14" Foreground="White"
                                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <TextBlock x:Name="NoCallText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Start a consultation to bring in the MDT. Video tiles, audio and the data channel are simulated in this prototype; the Webex Meetings SDK replaces them in the production client." />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ToggleButton x:Name="MicToggle" IsChecked="True" IsEnabled="False" AutomationProperties.Name="Microphone" ToolTipService.ToolTip="Microphone">
                                <SymbolIcon Symbol="Microphone" />
                            </ToggleButton>
                            <ToggleButton x:Name="CameraToggle" IsChecked="True" IsEnabled="False" AutomationProperties.Name="Camera" ToolTipService.ToolTip="Camera">
                                <SymbolIcon Symbol="Video" />
                            </ToggleButton>
                            <ToggleSwitch x:Name="ShareToggle" OnContent="Sharing my viewport" OffContent="Viewport not shared" IsOn="True" Toggled="ShareToggle_Toggled" Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RemotePinButton" IsEnabled="False" Click="RemotePin_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="MapPin" />
                            <TextBlock Text="Simulate colleague pin" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RemoteViewButton" IsEnabled="False" Click="RemoteView_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Sync" />
                            <TextBlock Text="Simulate colleague viewport" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="LatencyText" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Sync activity" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ListView x:Name="ActivityList" Grid.Row="1" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="markup:SyncEvent">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Text="{x:Bind local:ConsultationPage.FormatEvent(At, Description, LatencyMs)}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: transcript -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Consultation capture" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="ClinicAVT speech-to-text (simulated) · processed locally" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="6">
                            <ToggleButton x:Name="CaptureToggle" Click="Capture_Click" AutomationProperties.Name="Simulate live capture of the sample MDT discussion" ToolTipService.ToolTip="Simulate live capture of the sample MDT discussion">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#D13438" />
                                    <TextBlock x:Name="CaptureText" Text="Capture" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Click="LoadSample_Click" AutomationProperties.Name="Load the sample MDT dialogue" ToolTipService.ToolTip="Load the sample MDT dialogue">
                                <SymbolIcon Symbol="Download" />
                            </Button>
                            <Button Click="ClearTranscript_Click" AutomationProperties.Name="Clear transcript" ToolTipService.ToolTip="Clear transcript">
                                <SymbolIcon Symbol="Delete" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="TranscriptList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="notes:TranscriptLine">
                                <StackPanel Padding="0,6">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource HoloAccentBrush}">
                                        <Run Text="{x:Bind Speaker}" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="{x:Bind local:ConsultationPage.FormatOffset(Offset)}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyTranscriptText" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxWidth="320"
                               Text="Nothing captured yet. Press Capture to replay a sample MDT discussion, or type lines below." />

                    <Grid Grid.Row="2" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SpeakerBox" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="Speaker" />
                        <TextBox x:Name="LineBox" Grid.Column="1" PlaceholderText="Type what was said…" KeyDown="LineBox_KeyDown" />
                        <Button Grid.Column="2" Click="AddLine_Click" AutomationProperties.Name="Add line" ToolTipService.ToolTip="Add line">
                            <SymbolIcon Symbol="Send" />
                        </Button>
                    </Grid>

                    <Button Grid.Row="3" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="GenerateNotes_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Document" />
                            <TextBlock Text="Generate clinical notes" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
