<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HoloRepository.App.Pages.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HoloRepository.App.Controls"
    xmlns:local="using:HoloRepository.App.Pages"
    NavigationCacheMode="Required">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootGrid" Padding="16,8,16,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MaxWidth="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock x:Name="SeriesTitle" Text="Viewer" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SeriesSubtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" VerticalAlignment="Center">
                <AppBarToggleButton x:Name="NavigateTool" Label="Navigate" Tag="Navigate" Click="Tool_Click" IsChecked="True"
                                    ToolTipService.ToolTip="Click or drag to line up the other views">
                    <AppBarToggleButton.Icon>
                        <SymbolIcon Symbol="TouchPointer" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="PinTool" Label="Pin" Tag="Pin" Click="Tool_Click" ToolTipService.ToolTip="Drop a pin">
                    <AppBarToggleButton.Icon>
                        <SymbolIcon Symbol="MapPin" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="MeasureTool" Label="Measure" Tag="Measure" Click="Tool_Click" ToolTipService.ToolTip="Drag to measure a distance in mm">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xECC6;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="CalloutTool" Label="Note" Tag="Callout" Click="Tool_Click" ToolTipService.ToolTip="Add a text note on the scan">
                    <AppBarToggleButton.Icon>
                        <SymbolIcon Symbol="Comment" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarSeparator />
                <AppBarButton x:Name="FindOrgansButton" Label="Find organs" Click="FindOrgans_Click" ToolTipService.ToolTip="Outline organs and structures automatically">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarToggleButton x:Name="OrgansToggle" Label="Show organs" IsChecked="True" IsEnabled="False" Click="OrgansToggle_Click">
                    <AppBarToggleButton.Icon>
                        <SymbolIcon Symbol="View" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarSeparator />
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <ComboBox x:Name="PresetBox" PlaceholderText="Custom" MinWidth="150" Margin="4,0" SelectionChanged="PresetBox_SelectionChanged"
                              ToolTipService.ToolTip="Tissue view (window)" />
                </AppBarElementContainer>
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <ComboBox x:Name="RenderBox" MinWidth="170" Margin="4,0" SelectionChanged="RenderBox_SelectionChanged" ToolTipService.ToolTip="3D view style">
                        <x:String>3D · tissue and bone</x:String>
                        <x:String>3D · bone</x:String>
                        <x:String>3D · brightest (MIP)</x:String>
                    </ComboBox>
                </AppBarElementContainer>
                <AppBarButton Label="Reset" Click="Reset_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Refresh" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="NewWindowButton" Label="New window" Click="NewWindow_Click" ToolTipService.ToolTip="Open a second viewer window">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="NewWindow" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SideColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ViewportGrid" RowSpacing="6" ColumnSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <controls:SliceViewport x:Name="AxialView" Title="Axial" />
                <controls:SliceViewport x:Name="CoronalView" Grid.Column="1" Title="Coronal" />
                <controls:SliceViewport x:Name="SagittalView" Grid.Row="1" Title="Sagittal" />
                <controls:VolumeViewport x:Name="VolumeView" Grid.Row="1" Grid.Column="1" Title="3D" />
            </Grid>

            <StackPanel x:Name="NoSeriesPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <FontIcon Glyph="&#xF158;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No scan open" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Open a scan to view it in axial, coronal, sagittal and 3D." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <Button Content="Open the sample chest CT" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="LoadSample_Click" />
            </StackPanel>

            <Border x:Name="SidePanel" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Organs and structures -->
                    <StackPanel x:Name="OrgansPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="Organs and structures" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel x:Name="SegmentProgressPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <ProgressRing IsActive="True" Width="16" Height="16" />
                            <TextBlock x:Name="SegmentProgressText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxWidth="200" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Cancel" Padding="4,0" Click="CancelSegmentation_Click" />
                        </StackPanel>
                        <ItemsControl x:Name="StructureList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:StructureRow">
                                    <Grid ColumnSpacing="8" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{x:Bind IsVisible, Mode=OneWay}" Tag="{x:Bind Label}" MinWidth="0" Padding="4,0,0,0"
                                                  Click="StructureCheck_Click" AutomationProperties.Name="{x:Bind Name}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{x:Bind Brush}" />
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind VolumeText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="SegmentNoteText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <MenuFlyoutSeparator />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <TextBlock Text="Markup" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Padding="8,4" Click="ClearMarkup_Click" AutomationProperties.Name="Remove all markup on this scan" ToolTipService.ToolTip="Remove all markup on this scan">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </Grid>

                    <ListView x:Name="AnnotationList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="AnnotationList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AnnotationRow">
                                <Grid Padding="0,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{x:Bind Brush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Padding="6" Background="Transparent" BorderThickness="0" Tag="{x:Bind Id}" Click="DeleteAnnotation_Click"
                                            AutomationProperties.Name="Delete" ToolTipService.ToolTip="Delete">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyMarkupText" Grid.Row="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="No markup yet. Choose Pin, Measure or Note, then click on a slice. Markup is shared with colleagues during a consultation." />

                    <StackPanel Grid.Row="3" Spacing="4">
                        <MenuFlyoutSeparator />
                        <TextBlock x:Name="SyncText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                   Text="Mouse wheel: change slice · Right-drag: brightness and contrast · 3D: drag to rotate, wheel to zoom" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
