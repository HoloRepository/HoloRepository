<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HoloRepository.App.Pages.ViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HoloRepository.App.Controls"
    xmlns:local="using:HoloRepository.App.Pages"
    NavigationCacheMode="Required">

    <Grid Padding="16,8,16,16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MaxWidth="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock x:Name="SeriesTitle" Text="Viewer" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SeriesSubtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" VerticalAlignment="Center">
                <AppBarToggleButton x:Name="NavigateTool" Label="Navigate" Tag="Navigate" Click="Tool_Click" IsChecked="True"
                                    ToolTipService.ToolTip="Click or drag to move the crosshair. Wheel = slice, right-drag = window/level.">
                    <AppBarToggleButton.Icon>
                        <SymbolIcon Symbol="TouchPointer" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="PinTool" Label="Pin" Tag="Pin" Click="Tool_Click" ToolTipService.ToolTip="Drop a spatial pin">
                    <AppBarToggleButton.Icon>
                        <SymbolIcon Symbol="MapPin" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="MeasureTool" Label="Measure" Tag="Measure" Click="Tool_Click" ToolTipService.ToolTip="Drag to measure a distance in mm">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xECC6;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="CalloutTool" Label="Callout" Tag="Callout" Click="Tool_Click" ToolTipService.ToolTip="Add a text callout">
                    <AppBarToggleButton.Icon>
                        <SymbolIcon Symbol="Comment" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarSeparator />
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <ComboBox x:Name="PresetBox" PlaceholderText="Custom W/L" MinWidth="150" Margin="4,0" SelectionChanged="PresetBox_SelectionChanged"
                              ToolTipService.ToolTip="Window / level preset" />
                </AppBarElementContainer>
                <AppBarElementContainer VerticalContentAlignment="Center">
                    <ComboBox x:Name="RenderBox" MinWidth="170" Margin="4,0" SelectionChanged="RenderBox_SelectionChanged" ToolTipService.ToolTip="3D rendering mode">
                        <x:String>Volume · tissue + bone</x:String>
                        <x:String>Volume · bone</x:String>
                        <x:String>Maximum intensity (MIP)</x:String>
                    </ComboBox>
                </AppBarElementContainer>
                <AppBarButton Label="Reset" Click="Reset_Click">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Refresh" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="NewWindowButton" Label="New window" Click="NewWindow_Click" ToolTipService.ToolTip="Open another synchronised viewer window">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="NewWindow" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ViewportGrid" RowSpacing="6" ColumnSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <controls:SliceViewport x:Name="AxialView" Title="Axial" />
                <controls:SliceViewport x:Name="CoronalView" Grid.Column="1" Title="Coronal" />
                <controls:SliceViewport x:Name="SagittalView" Grid.Row="1" Title="Sagittal" />
                <controls:VolumeViewport x:Name="VolumeView" Grid.Row="1" Grid.Column="1" Title="3D" />
            </Grid>

            <StackPanel x:Name="NoSeriesPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="Collapsed">
                <FontIcon Glyph="&#xF158;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No series open" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Load a study to view it in axial, coronal, sagittal and 3D." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <Button Content="Load sample chest CT" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="LoadSample_Click" />
            </StackPanel>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Spatial markup" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Padding="8,4" Click="ClearMarkup_Click" AutomationProperties.Name="Remove all markup on this series" ToolTipService.ToolTip="Remove all markup on this series">
                            <SymbolIcon Symbol="Delete" />
                        </Button>
                    </Grid>

                    <ListView x:Name="AnnotationList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="AnnotationList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AnnotationRow">
                                <Grid Padding="0,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" Fill="{x:Bind Brush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Padding="6" Background="Transparent" BorderThickness="0" Tag="{x:Bind Id}" Click="DeleteAnnotation_Click"
                                            AutomationProperties.Name="Delete" ToolTipService.ToolTip="Delete">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyMarkupText" Grid.Row="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="No markup yet. Choose Pin, Measure or Callout and click on a slice. Markup is stored in patient coordinates and shared with the consultation." />

                    <StackPanel Grid.Row="2" Spacing="4">
                        <MenuFlyoutSeparator />
                        <TextBlock x:Name="SyncText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                   Text="Wheel: change slice · Right-drag: window/level · 3D: drag to rotate, wheel to zoom" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
