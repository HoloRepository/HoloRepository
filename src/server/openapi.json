{
  "openapi": "3.1.0",
  "info": {
    "title": "HoloRepository API",
    "description": "\nThe API accepts one ZIP archive of DICOM files or one NIfTI file, segments it with a\nselected model, and returns downloadable results, including an `.mz3` mesh.\n\n## Client workflow\n\n1. Upload a file and pick a model with `POST /new-job`.\n2. Poll `GET /job-status?job_id=...` until `status` is `done`.\n3. Find the record's files with `GET /records`, then download each with\n   `GET /files/{file_id}`.\n\nDurations are in seconds. Display `.mz3` meshes with\n[NiiVue](https://niivue.com/docs/guide/meshes/).\n",
    "version": "0.1.0"
  },
  "paths": {
    "/new-job": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Create Job",
        "description": "Upload a file and start processing it.\n\nSend `multipart/form-data`. For DICOM, ZIP the folder and send the ZIP as `file`;\nthe server extracts it.",
        "operationId": "create_job_new_job_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_job_new_job_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/job-status": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job Status",
        "description": "Get a processing job's status.",
        "operationId": "get_job_status_job_status_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/records": {
      "get": {
        "tags": [
          "records"
        ],
        "summary": "List Records",
        "description": "List records. Each record links all the files that belong to one upload.",
        "operationId": "list_records_records_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Record"
                  },
                  "type": "array",
                  "title": "Response List Records Records Get"
                }
              }
            }
          }
        }
      }
    },
    "/files/{file_id}": {
      "get": {
        "tags": [
          "records"
        ],
        "summary": "Download File",
        "description": "Download a file's raw bytes.",
        "operationId": "download_file_files__file_id__get",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "File Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/octet-stream": {}
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_create_job_new_job_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "One ZIP archive of a DICOM folder, or one NIfTI file."
          },
          "file_type": {
            "$ref": "#/components/schemas/FileType"
          },
          "model": {
            "$ref": "#/components/schemas/SegmentationModel",
            "default": "nv-segment-ct"
          }
        },
        "type": "object",
        "required": [
          "file",
          "file_type"
        ],
        "title": "Body_create_job_new_job_post"
      },
      "FileRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Use with `GET /files/{file_id}`."
          },
          "file_type": {
            "$ref": "#/components/schemas/FileType"
          },
          "mesh_style": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MeshStyle"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set for `mz3` files only. Show one style at a time and switch between them to toggle colours and textures."
          }
        },
        "type": "object",
        "required": [
          "id",
          "file_type"
        ],
        "title": "FileRecord",
        "description": "A single file. Download it with `GET /files/{file_id}`."
      },
      "FileType": {
        "type": "string",
        "enum": [
          "dicom",
          "nifti",
          "nifti_segmented",
          "mz3"
        ],
        "title": "FileType",
        "description": "Kind of file stored on the server."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Use with `GET /job-status`."
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "Job",
        "description": "A newly started job."
      },
      "JobStatus": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "msg": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Msg"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "JobStatus",
        "description": "Status of a processing job."
      },
      "MeshStyle": {
        "type": "string",
        "enum": [
          "coloured",
          "textured"
        ],
        "title": "MeshStyle",
        "description": "How a mesh is coloured. Both styles of one record share the same geometry."
      },
      "Record": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileRecord"
            },
            "type": "array",
            "title": "Files"
          }
        },
        "type": "object",
        "required": [
          "id",
          "files"
        ],
        "title": "Record",
        "description": "A record, linking all the files that belong to one upload."
      },
      "SegmentationModel": {
        "type": "string",
        "enum": [
          "nv-segment-ct",
          "ts-specialist-kidney",
          "ts-specialist-liver",
          "ts-specialist-head-n-neck"
        ],
        "title": "SegmentationModel",
        "description": "Model used to segment the upload."
      },
      "Status": {
        "type": "string",
        "enum": [
          "in_queue",
          "in_progress",
          "done",
          "error"
        ],
        "title": "Status",
        "description": "Processing state of a job."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
